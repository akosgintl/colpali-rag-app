# Qdrant Vector Database
QDRANT_URL=https://your-qdrant-instance.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key
COLLECTION_NAME=colpali

# Supabase Storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
# SUPABASE_JWT_SECRET=your-jwt-secret  # Required if AUTH_ENABLED=true

# Anthropic API (for Claude response generation)
ANTHROPIC_API_KEY=sk-ant-your-key
# DEFAULT_MODEL=claude-sonnet-4-20250514  # LLM model for response generation
# MAX_TOKENS=8192
# TEMPERATURE=0.0

# ===================
# Authentication (Optional)
# ===================
# AUTH_ENABLED=true  # Set to false to disable JWT authentication
# ALLOWED_ORIGINS=["https://yourapp.com"]  # CORS allowed origins

# ===================
# Processing Limits (Optional)
# ===================
# MAX_FILE_SIZE_MB=50           # Maximum file size per PDF
# MAX_TOTAL_UPLOAD_MB=200       # Maximum total upload size
# MAX_PAGES_PER_BATCH=5         # Pages processed per batch
# MAX_PDF_PAGES=200             # Maximum pages per PDF
# CLEAR_CUDA_CACHE_INTERVAL=10  # Clear GPU memory every N batches

# ===================
# Rate Limiting (Optional)
# ===================
# QUERY_RATE_LIMIT=30/minute    # Rate limit for /query/ endpoint
# INGEST_RATE_LIMIT=10/minute   # Rate limit for /ingest-pdfs/ endpoint

# ===================
# Timeouts (Optional)
# ===================
# INGEST_ENDPOINT_TIMEOUT_SECONDS=600     # Timeout for /ingest-pdfs/ endpoint
# QUERY_ENDPOINT_TIMEOUT_SECONDS=180      # Timeout for /query/ endpoint

# Integration timeouts
# QDRANT_TIMEOUT_SECONDS=60               # Qdrant vector database operations
# SUPABASE_TIMEOUT_SECONDS=120            # Supabase storage operations
# ANTHROPIC_TIMEOUT_SECONDS=180           # Claude API calls

# Processing timeouts
# PDF_CONVERSION_TIMEOUT_SECONDS=120      # PDF to image conversion
# COLPALI_INFERENCE_TIMEOUT_SECONDS=60    # ColPali model inference

# ===================
# Model Configuration (Optional)
# ===================
# COLPALI_MODEL_NAME=vidore/colqwen2.5-v0.2
# MAX_CONCURRENT_INFERENCES=1  # Concurrent model inference limit

# ===================
# Server Configuration (Optional)
# ===================
# WORKERS=1  # Number of Gunicorn workers (1 per GPU recommended for GPU workloads)
# PORT=8000  # Server port

# ===================
# Docker Hub (for RunPod deployment)
# ===================
# DOCKERHUB_USERNAME=your-dockerhub-username
