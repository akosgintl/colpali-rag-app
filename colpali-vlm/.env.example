# ===================
# ColPali VLM Service Configuration
# ===================

# Model Configuration
COLPALI_MODEL_NAME=vidore/colqwen2.5-v0.2   # Model to use: vidore/colqwen2.5-v0.2 | TomoroAI/tomoro-colqwen3-embed-4b
COLPALI_MODEL_TYPE=auto                      # Model type: auto | colqwen2.5 | colqwen3 | tomoro-colqwen3
COLPALI_VECTOR_DIM=128                       # Vector dimension: 128 for ColQwen2.5, 320 for ColQwen3/TomoroAI

# To use ColQwen2.5 model (default):
# COLPALI_MODEL_NAME=vidore/colqwen2.5-v0.2
# COLPALI_MODEL_TYPE=auto
# COLPALI_VECTOR_DIM=128

# To use TomoroAI model (SOTA performance, 320-dim):
# COLPALI_MODEL_NAME=TomoroAI/tomoro-colqwen3-embed-4b
# COLPALI_MODEL_TYPE=auto
# COLPALI_VECTOR_DIM=320

# Concurrency
MAX_CONCURRENT_INFERENCES=1                  # Max concurrent model inferences (1 recommended per GPU)

# Timeouts
INFERENCE_TIMEOUT_SECONDS=60                 # Model inference timeout

# Server Configuration
WORKERS=1                                    # Number of uvicorn workers (1 per GPU recommended)
HOST=0.0.0.0                                 # Server bind address
PORT=8000                                    # Server port (container internal port, mapped to 8001 on host)

# ===================
# Authentication (Optional)
# ===================
# Set AUTH_ENABLED=true to require API key authentication for /embed/* endpoints
# Health endpoint remains unauthenticated for Docker healthchecks

AUTH_ENABLED=false                           # Enable API key authentication
VLM_API_KEY=your-secret-api-key             # Required if AUTH_ENABLED=true
