# RunPod-optimized Dockerfile with CUDA 12.8, PyTorch 2.8, Flash Attention 2, and pre-downloaded models
# Uses RunPod's official PyTorch image as base for compatibility
# Image size: ~15GB (PyTorch + CUDA + flash-attn + models)

# Stage 1: Dependencies (use RunPod base image with PyTorch 2.8.0 + CUDA 12.8.1)
FROM runpod/pytorch:1.0.2-cu1281-torch280-ubuntu2404 AS deps

ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_PREFERENCE=only-system

WORKDIR /app

# Install uv
RUN curl -LsSf https://astral.sh/uv/install.sh | sh

ENV PATH="/root/.local/bin:/app/.venv/bin:$PATH"

# Install flash-attn from prebuilt wheel (CUDA 12.8 + PyTorch 2.8)
RUN pip install https://github.com/mjun0812/flash-attention-prebuild-wheels/releases/download/v0.7.2/flash_attn-2.8.3%2Bcu128torch2.8-cp312-cp312-linux_x86_64.whl

# Copy dependency files
COPY pyproject.toml uv.lock ./
RUN touch README.md

# Create venv using system Python (3.12) and inheriting system packages (PyTorch, flash-attn)
RUN uv venv --system-site-packages && \
    uv sync --frozen --no-install-project --no-dev --no-cache

# Install packages that must be in venv (not system site-packages) to survive COPY
# cffi: C extension needed by tokenizers/cryptography, breaks if only in system packages
RUN uv pip install cffi auto-round>=0.5 --no-cache

# Stage 2: Download model weights (cached layer)
FROM deps AS model-download

# Download models to cache
ARG COLPALI_MODEL_1=TomoroAI/tomoro-colqwen3-embed-4b
ARG COLPALI_MODEL_2=vidore/colqwen2.5-v0.2
ENV HF_HOME=/app/model_cache
RUN python3 -c "from huggingface_hub import snapshot_download; snapshot_download('${COLPALI_MODEL_1}')"
RUN python3 -c "from huggingface_hub import snapshot_download; snapshot_download('${COLPALI_MODEL_2}')"

# Stage 3: Build application
FROM deps AS builder
COPY src/ ./src/
COPY server.py ./
RUN uv sync --frozen --no-dev --no-cache

# Stage 4: Runtime (use same RunPod base for compatibility)
FROM runpod/pytorch:1.0.2-cu1281-torch280-ubuntu2404 AS runtime

ENV PYTHONUNBUFFERED=1
ENV HF_HOME=/app/model_cache
ENV HF_HUB_ENABLE_HF_TRANSFER=0

WORKDIR /app

# Install flash-attn from prebuilt wheel (same as deps stage)
RUN pip install https://github.com/mjun0812/flash-attention-prebuild-wheels/releases/download/v0.7.2/flash_attn-2.8.3%2Bcu128torch2.8-cp312-cp312-linux_x86_64.whl

# Copy from builder stages
COPY --from=builder /app/.venv /app/.venv
COPY --from=builder /app/src /app/src
COPY --from=builder /app/server.py /app/server.py
COPY --from=model-download /app/model_cache /app/model_cache

ENV PATH="/app/.venv/bin:$PATH" PYTHONPATH="/app/src"

# Expose port (RunPod uses 8000 by default for HTTP)
EXPOSE 8000

# Health check for RunPod
HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Note: For GPU workloads, stick to 1 worker per GPU since each worker loads its own model copy (~8GB).
# Use WORKERS env var to configure worker count (default: 1)
CMD ["sh", "-c", "gunicorn server:app --workers ${WORKERS:-1} --worker-class uvicorn.workers.UvicornWorker --bind 0.0.0.0:${PORT:-8000} --timeout 600"]
