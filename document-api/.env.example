# ===================
# Document API Service Configuration
# ===================

# VLM Service Connection
VLM_SERVICE_URL=http://localhost:8001        # URL of the ColPali VLM service (or RunPod URL in production)
VLM_TIMEOUT_SECONDS=120                      # Timeout for VLM service requests

# Qdrant Vector Database (Required)
QDRANT_URL=https://your-qdrant-instance.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key
COLLECTION_NAME=colpali
VECTOR_DIM=128                               # Must match VLM service: 128 for ColQwen2.5, 320 for ColQwen3/TomoroAI

# Supabase Storage (Required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret          # Required if AUTH_ENABLED=true
BUCKET=colpali                               # Supabase storage bucket name

# Anthropic API (Required)
ANTHROPIC_API_KEY=sk-ant-your-key
DEFAULT_MODEL=claude-sonnet-4-20250514       # LLM model for response generation
MAX_TOKENS=8192                              # Max tokens for LLM response
TEMPERATURE=0.0                              # LLM temperature (0.0 = deterministic)

# ===================
# Authentication
# ===================
AUTH_ENABLED=true                            # Enable/disable JWT authentication
ALLOWED_ORIGINS=["*"]                        # CORS allowed origins (use specific domains in production)

# ===================
# Processing Limits
# ===================
MAX_FILE_SIZE_MB=50                          # Maximum file size per PDF
MAX_TOTAL_UPLOAD_MB=200                      # Maximum total upload size per request
MAX_PAGES_PER_BATCH=5                        # Pages processed per embedding batch
MAX_PDF_PAGES=200                            # Maximum pages per PDF

# ===================
# Rate Limiting
# ===================
QUERY_RATE_LIMIT=30/minute                   # Rate limit for /query/ endpoint
INGEST_RATE_LIMIT=10/minute                  # Rate limit for /ingest-pdfs/ endpoint

# ===================
# Endpoint Timeouts
# ===================
INGEST_ENDPOINT_TIMEOUT_SECONDS=600          # Overall timeout for /ingest-pdfs/ endpoint
QUERY_ENDPOINT_TIMEOUT_SECONDS=180           # Overall timeout for /query/ endpoint

# ===================
# Integration Timeouts
# ===================
QDRANT_TIMEOUT_SECONDS=60                    # Qdrant vector database operations
SUPABASE_TIMEOUT_SECONDS=120                 # Supabase storage operations
ANTHROPIC_TIMEOUT_SECONDS=180                # Claude API calls
PDF_CONVERSION_TIMEOUT_SECONDS=120           # PDF to image conversion

# ===================
# Server Configuration
# ===================
WORKERS=1                                    # Number of uvicorn workers
HOST=0.0.0.0                                 # Server bind address
PORT=8000                                    # Server port (API service runs on 8000)
